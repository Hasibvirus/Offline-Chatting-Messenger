    <string name="onboarding_title_1">Communicate Without Internet</string>
    <string name="onboarding_desc_1">Connect directly with nearby Android phones over Google Nearby Connections, local Wi-Fi, Mobile Hotspot, or Bluetooth — zero cellular or cloud servers needed.</string>
    <string name="onboarding_title_2">Honest Range &amp; Hardware Limits</string>
    <string name="onboarding_desc_2">Offline radios work within local physical range (~10–100m depending on walls and hardware). Groups use a Host-and-Members hub model for reliable delivery.</string>
    <string name="onboarding_title_3">Verified Cryptographic Security</string>
    <string name="onboarding_desc_3">Every private room and group pairs via ephemeral ECDH (P-256) key exchange, HKDF-SHA256, and AES-256-GCM encryption with a Safety Verification Code.</string>

